# Released artifacts — data/ and results/ are tracked on purpose. Do not add
# them here: they are what makes this repository a reproducible supplement.

# Model weights. Backbones download on demand; trained checkpoints total ~1.7 GB
# and every number they produced is recorded in results/.
*.pt

# Credentials. Only scripts/dataset_prepare.py --source roboflow reads this,
# and reproduction never needs it. See .env.example.
.env

# Generated by scripts/dataset_analysis.py; regenerate rather than commit.
/figures/
data/dataset_analysis_report*.html

# Training output tree (checkpoints, plots, per-epoch caches). The published
# subset is copied into results/.
/run/
/wandb/

# Source frames and intermediate annotation state, not part of the release.
/archive/
/.draft/
data/.draft/
data/**/labels.cache

# Manuscript. `paper` is a working symlink into the private paper repository.
/paper

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor / OS
.vscode/
.idea/
.DS_Store
*.log


