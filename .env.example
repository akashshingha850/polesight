# Only scripts/dataset_prepare.py --source roboflow and the tag lookup in
# scripts/image_metadata.py read this file, and both target the authors'
# private annotation workspace. Reproducing the published results does not
# need it: data/ ships already prepared.
#
# Copy to .env and fill in if you are re-exporting from your own Roboflow
# project. Never commit the result.
ROBOFLOW_API=
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=
ROBOFLOW_VERSION=
